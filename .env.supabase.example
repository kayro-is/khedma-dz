# =============================================================================
# Connexion aux projets Supabase Cloud — MODÈLE (aucun secret ici)
# Copier vers .env.supabase.local (ignoré par Git) et remplir dans VS Code.
# Ne jamais coller ces valeurs dans un chat, un ticket ou un commit.
# Utilisé uniquement par « pnpm cloud <test|prod> <action> » (scripts/supabase-cloud.mjs).
# =============================================================================

# --- Projet de TEST (données de démonstration, tests pgTAP et d'intégration) ---
# Project Settings > General > Project ID (20 lettres minuscules)
SUPABASE_TEST_PROJECT_REF=
# Mot de passe de la base, défini à la création du projet
SUPABASE_TEST_DB_PASSWORD=
# Bouton « Connect » > Connection string > Session pooler > URI
# Coller tel quel, avec le texte [YOUR-PASSWORD] : le script le remplace lui-même.
SUPABASE_TEST_POOLER_URL=
# Project Settings > API Keys > Publishable key (sb_publishable_...) — clé publique
SUPABASE_TEST_PUBLISHABLE_KEY=

# --- Projet PRINCIPAL (aucune donnée de démonstration, jamais de tests) ---
SUPABASE_PROD_PROJECT_REF=
SUPABASE_PROD_DB_PASSWORD=
SUPABASE_PROD_POOLER_URL=
