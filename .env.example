# =============================================================================
# Khedma DZ — variables des applications (MODÈLE, sans aucun secret)
# Copier dans les fichiers indiqués. Ne jamais commiter de .env.
# Pendant le développement, les applications pointent vers le projet Supabase de TEST.
# Valeurs : dashboard du projet > Project Settings > API Keys / Data API.
# La connexion CLI aux bases se configure à part : .env.supabase.example.
# =============================================================================

# --- Application mobile : apps/mobile/.env ------------------------------------
# Les variables EXPO_PUBLIC_* sont incluses dans le bundle : uniquement des valeurs publiques.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) — clé publique, protégée par la RLS
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Administration : apps/admin/.env.local -----------------------------------
# NEXT_PUBLIC_* est exposé au navigateur : uniquement des valeurs publiques.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Côté serveur uniquement (à partir de KHD-017). JAMAIS de préfixe NEXT_PUBLIC_.
# Secret key (sb_secret_...) : ne jamais la placer dans l'application mobile.
SUPABASE_SERVICE_ROLE_KEY=
